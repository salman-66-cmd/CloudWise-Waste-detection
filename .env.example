# Smart Cloud Resource Waste Detector - Environment Configuration

# Database
# For local development without Docker, SQLite fallback runs automatically:
DATABASE_URL=sqlite:///./cloudwise.db
# For PostgreSQL / Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudwise

# Security & Authentication
SECRET_KEY=cloudwise_super_secret_jwt_key_2026_dev_mode_change_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Algorithmic Waste Engine Thresholds (All Configurable)
IDLE_CPU_THRESHOLD_PERCENT=5.0
UNDERUTILIZED_CPU_THRESHOLD_PERCENT=20.0
LOW_MEMORY_THRESHOLD_PERCENT=25.0
UNATTACHED_STORAGE_DAYS_THRESHOLD=7
LOW_TRAFFIC_LB_MBPS_THRESHOLD=0.5
STALE_RESOURCE_DAYS_THRESHOLD=14
MONTHLY_BILLABLE_HOURS=730.0

# Optional AWS Read-Only Integration
# If left blank, the application operates in 100% full-featured simulation mode
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENABLED=false
